---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatPostDate } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="blog-post">
    <a class="back-link" href="/blog/">← All posts</a>
    <header>
      <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </header>
    <div class="post-content">
      <slot />
    </div>
    <footer>
      <a href="/blog/">All posts</a>
      <a href="/rss.xml">Subscribe via RSS</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .blog-post {
    width: min(44rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    overflow-wrap: anywhere;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
  }

  time {
    color: var(--muted);
    font-size: 0.95rem;
  }

  h1 {
    font-size: clamp(2.3rem, 5vw, 3.6rem);
    line-height: 1.1;
    text-wrap: balance;
  }

  header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2rem;
  }

  .post-content {
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .post-content :global(p),
  .post-content :global(ul),
  .post-content :global(ol),
  .post-content :global(blockquote),
  .post-content :global(pre),
  .post-content :global(table),
  .post-content :global(figure) {
    margin-block: 1.25rem;
  }

  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    margin-block: 2.25rem 0.85rem;
    line-height: 1.25;
    scroll-margin-top: 1.5rem;
  }

  .post-content :global(h2) {
    font-size: clamp(1.65rem, 3vw, 2rem);
  }

  .post-content :global(h3) {
    font-size: 1.35rem;
  }

  .post-content :global(li + li) {
    margin-top: 0.5rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.5rem;
  }

  a,
  .post-content :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .post-content :global(blockquote) {
    padding-left: 1.25rem;
    border-left: 3px solid var(--clay);
    margin-inline: 0;
    color: var(--muted);
  }

  .post-content :global(img),
  .post-content :global(video) {
    max-width: 100%;
    height: auto;
  }

  .post-content :global(pre) {
    padding: 1rem;
    overflow-x: auto;
    border-radius: 0.4rem;
    font-size: 0.9rem;
    overflow-wrap: normal;
  }

  .post-content :global(:not(pre) > code) {
    padding: 0.15rem 0.3rem;
    background: var(--line);
    border-radius: 0.2rem;
    font-size: 0.9em;
  }

  .post-content :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--line);
    text-align: left;
  }

  .post-content :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin-block: 2rem;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
