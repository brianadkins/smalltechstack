---
const lightAssets = [
  ['sts-mark-on-light.svg', 'SVG mark'],
  ['sts-mark-on-light-512.png', 'PNG mark, 512px'],
  ['sts-logo-on-light.svg', 'SVG full logo'],
  ['sts-logo-on-light-800.png', 'PNG full logo, 800px'],
];

const darkAssets = [
  ['sts-mark-on-dark.svg', 'SVG mark'],
  ['sts-mark-on-dark-512.png', 'PNG mark, 512px'],
  ['sts-logo-on-dark.svg', 'SVG full logo'],
  ['sts-logo-on-dark-800.png', 'PNG full logo, 800px'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>STS Logo Asset Review</title>
    <style>
      :root {
        --ink: #1f2520;
        --muted: #626862;
        --line: #d8ddd5;
        --paper: #fbfaf4;
        --dark: #141b16;
        --dark-panel: #1f2a22;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        line-height: 1.5;
      }

      main {
        width: min(1120px, calc(100% - 2rem));
        margin: 0 auto;
        padding: 3rem 0 5rem;
      }

      h1,
      h2,
      p {
        margin: 0;
      }

      h1 {
        font-size: clamp(2rem, 5vw, 4rem);
        line-height: 1;
      }

      .intro {
        max-width: 720px;
        margin-top: 1rem;
        color: var(--muted);
      }

      .section {
        margin-top: 3rem;
      }

      .section h2 {
        margin-bottom: 1rem;
        font-size: 1.2rem;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .sample {
        border: 1px solid var(--line);
        background: white;
      }

      .sample.dark {
        border-color: #36423a;
        background: var(--dark);
        color: var(--paper);
      }

      .stage {
        display: grid;
        min-height: 220px;
        place-items: center;
        padding: 2rem;
      }

      .stage.checker {
        background-color: #fff;
        background-image:
          linear-gradient(45deg, #edf0ec 25%, transparent 25%),
          linear-gradient(-45deg, #edf0ec 25%, transparent 25%),
          linear-gradient(45deg, transparent 75%, #edf0ec 75%),
          linear-gradient(-45deg, transparent 75%, #edf0ec 75%);
        background-position:
          0 0,
          0 10px,
          10px -10px,
          -10px 0;
        background-size: 20px 20px;
      }

      .sample.dark .stage.checker {
        background-color: var(--dark-panel);
        background-image:
          linear-gradient(45deg, #263229 25%, transparent 25%),
          linear-gradient(-45deg, #263229 25%, transparent 25%),
          linear-gradient(45deg, transparent 75%, #263229 75%),
          linear-gradient(-45deg, transparent 75%, #263229 75%);
      }

      .label {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.8rem 1rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.9rem;
      }

      .dark .label {
        border-color: #36423a;
        color: #c9d0c7;
      }

      code {
        color: inherit;
        font-family:
          "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
      }

      img {
        display: block;
        max-width: 100%;
        height: auto;
      }

      .mark {
        width: min(240px, 58vw);
      }

      .logo {
        width: min(560px, 82vw);
      }

      @media (max-width: 760px) {
        .grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>STS Logo Asset Review</h1>
      <p class="intro">
        Each asset is shown on the background it is meant to be used on. The
        checkerboard helps reveal transparent PNG and SVG backgrounds.
      </p>

      <section class="section" aria-labelledby="source-title">
        <h2 id="source-title">Canonical Source</h2>
        <div class="grid">
          <article class="sample">
            <div class="stage checker">
              <img class="mark" src="/brand/sts-mark.svg" alt="Canonical STS mark" />
            </div>
            <div class="label">
              <code>sts-mark.svg</code>
              <span>canonical mark</span>
            </div>
          </article>
        </div>
      </section>

      <section class="section" aria-labelledby="light-title">
        <h2 id="light-title">For Light Backgrounds</h2>
        <div class="grid">
          {lightAssets.map(([file, label]) => (
            <article class="sample">
              <div class="stage checker">
                <img
                  class={file.includes('logo') ? 'logo' : 'mark'}
                  src={`/brand/${file}`}
                  alt={`STS ${label} for light backgrounds`}
                />
              </div>
              <div class="label">
                <code>{file}</code>
                <span>{label}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section" aria-labelledby="dark-title">
        <h2 id="dark-title">For Dark Backgrounds</h2>
        <div class="grid">
          {darkAssets.map(([file, label]) => (
            <article class="sample dark">
              <div class="stage checker">
                <img
                  class={file.includes('logo') ? 'logo' : 'mark'}
                  src={`/brand/${file}`}
                  alt={`STS ${label} for dark backgrounds`}
                />
              </div>
              <div class="label">
                <code>{file}</code>
                <span>{label}</span>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>
