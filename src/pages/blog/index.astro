---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPostDate, getPublishedPosts, postUrl } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog" description="Notes on small software projects, volunteer technology work, and what we learn along the way.">
  <div class="blog-index">
    <header>
      <p class="eyebrow">Small Tech Stack</p>
      <h1>Blog</h1>
      <p class="lede">Notes on small software projects, volunteer technology work, and what we learn along the way.</p>
      <a class="feed-link" href="/rss.xml">Subscribe via RSS</a>
    </header>

    {posts.length > 0 ? (
      <ol class="post-list">
        {posts.map((post) => (
          <li>
            <article>
              <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
              <h2><a href={postUrl(post.id)}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty-state">No posts yet. Check back soon, or subscribe to the feed for new posts.</p>
    )}
  </div>
</BaseLayout>

<style>
  .blog-index {
    width: min(48rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  header {
    padding-bottom: 2.5rem;
  }

  .feed-link {
    display: inline-block;
    margin-top: 1.5rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .post-list {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .post-list li,
  .empty-state {
    border-top: 1px solid var(--line);
    padding-block: 2rem;
  }

  time {
    color: var(--muted);
    font-size: 0.9rem;
  }

  h2 {
    margin-top: 0.65rem;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  h2 a:hover,
  h2 a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  article p {
    margin-top: 0.85rem;
    color: var(--muted);
  }
</style>
