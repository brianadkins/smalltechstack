---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../data/site';
---

<BaseLayout title={company.name} description={company.description}>
  <section class="hero">
    <div>
      <p class="eyebrow">Volunteer nonprofit IT</p>
      <h1>Technology for the little guy.</h1>
      <p class="lede">
        {company.name} keeps a small public home for volunteer IT work with
        nonprofits: websites, forms, spreadsheets, automations, simple apps, and
        the plain policy pages that need to sit beside them.
      </p>
      <div class="actions">
        <a class="button" href={`mailto:${company.email}`}>Send a note</a>
        <a class="button secondary" href="/nonprofits/">Nonprofit work</a>
      </div>
    </div>
    <aside class="fit-panel" aria-label="No-cost nonprofit project fit">
      <img
        class="hero-mark"
        src="/brand/sts-mark-on-light.svg"
        alt=""
        width="240"
        height="180"
        loading="eager"
      />
      <p class="eyebrow">Usually a fit</p>
      <h2>Small, specific, useful to the organization.</h2>
    </aside>
  </section>

</BaseLayout>
