---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<div data-blog-toc>
  <nav class="desktop-toc" aria-label="On this page">
    <p class="toc-title">On this page</p>
    <ol>
      {headings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
    </ol>
  </nav>
  <details class="mobile-toc">
    <summary>On this page</summary>
    <nav aria-label="On this page">
      <ol>
        {headings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
      </ol>
    </nav>
  </details>
</div>

<script>
  function initializeToc() {
    const root = document.querySelector<HTMLElement>('[data-blog-toc]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('a'));
    const ids = [...new Set(links.map((link) => decodeURIComponent(link.hash.slice(1))))];
    const headings = ids.map((id) => document.getElementById(id)).filter((heading): heading is HTMLElement => !!heading);
    if (!headings.length) return;

    const controller = new AbortController();
    let frame = 0;
    function update() {
      frame = 0;
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= 96) current = heading;
      }
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        current = headings[headings.length - 1];
      }
      for (const link of links) {
        if (decodeURIComponent(link.hash.slice(1)) === current.id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    }
    function scheduleUpdate() {
      if (!frame) frame = requestAnimationFrame(update);
    }
    for (const event of ['scroll', 'resize', 'hashchange']) {
      window.addEventListener(event, scheduleUpdate, { passive: true, signal: controller.signal });
    }
    document.addEventListener('astro:before-swap', () => {
      controller.abort();
      cancelAnimationFrame(frame);
    }, { once: true });
    update();
  }

  initializeToc();
  document.addEventListener('astro:page-load', initializeToc);
</script>

<style>
  .desktop-toc {
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    scrollbar-gutter: stable;
    border-left: 1px solid var(--line);
    padding-left: 1.25rem;
  }

  .toc-title,
  summary {
    font-weight: 750;
  }

  ol {
    padding: 0;
    margin: 0.85rem 0 0;
    list-style: none;
  }

  li + li {
    margin-top: 0.25rem;
  }

  a {
    display: block;
    border-left: 2px solid transparent;
    padding: 0.4rem 0.6rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.4;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible,
  a[aria-current="location"] {
    color: var(--ink);
    background: var(--panel);
    border-left-color: var(--clay);
  }

  a[aria-current="location"] {
    font-weight: 750;
  }

  .mobile-toc {
    display: none;
  }

  @media (max-width: 1020px) {
    .desktop-toc {
      display: none;
    }

    .mobile-toc {
      display: block;
      padding: 1rem;
      background: var(--panel);
      border: 1px solid var(--line);
    }

    summary {
      cursor: pointer;
    }
  }
</style>
